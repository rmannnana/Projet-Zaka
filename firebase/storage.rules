rules_version = '2';

// Arborescence :
//   public/orgs/{orgId}/...                photos d'annonces, logos (lecture publique)
//   public/users/{uid}/...                 photo de profil
//   private/verification/{orgId}/...       IFU, RCCM, justificatif de résidence
//   private/exports/...                    dossiers exportés pour un litige (Cloud Functions)
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ['admin', 'moderator'];
    }

    function isMember(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function orgCanUpload(orgId) {
      let org = firestore.get(/databases/(default)/documents/organizations/$(orgId)).data;
      return org.type != 'individual_owner'
        && org.verification.status in ['draft', 'rejected'];
    }

    function isImage(maxMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    function isDocument(maxMb) {
      return (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    match /public/orgs/{orgId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isMember(orgId) && isImage(10);
      allow delete: if isMember(orgId);
    }

    match /public/users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && isImage(5);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Pièces d'un compte pro : déposées tant que le dossier est en brouillon ou
    // refusé, jamais écrasées ni supprimées (trace en cas de contrôle).
    // Nom attendu : {ifu|rccm|proofOfAddress}_{horodatage}.{pdf|jpg|jpeg|png|webp}
    match /private/verification/{orgId}/{fileName} {
      allow read: if isMember(orgId) || isStaff();
      allow create: if resource == null
        && isMember(orgId)
        && isDocument(10)
        && fileName.matches('(ifu|rccm|proofOfAddress)_[0-9]+[.](pdf|jpe?g|png|webp)')
        && orgCanUpload(orgId);
      allow update, delete: if false;
    }

    match /private/exports/{allPaths=**} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
